# Энэ файлыг ".env" нэртэй хуулж, өөрийн Supabase утгуудаа бичнэ.
# Supabase → Project Settings → API (эсвэл "API Keys")
# АНХААР: зөвхөн anon / publishable түлхүүр. service_role / secret түлхүүрийг ЭНД БИЧИХГҮЙ.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
